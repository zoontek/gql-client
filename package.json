{
  "name": "@zoontek/gql-client",
  "version": "0.1.0",
  "description": "A simple, typesafe GraphQL client for React",
  "keywords": [
    "cache",
    "client",
    "gql",
    "graphql",
    "react"
  ],
  "homepage": "https://zoontek.github.io/gql-client",
  "license": "MIT",
  "author": "Mathieu Acthernoene <zoontek@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/zoontek/gql-client.git"
  },
  "bin": {
    "gql-schema-config": "bin/gql-schema-config"
  },
  "files": [
    "bin",
    "LICENSE",
    "dist",
    "README.md"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc",
    "test:unit": "bun test tests/unit/",
    "test:react": "playwright test",
    "test": "bun run test:unit && bun run test:react",
    "codegen": "graphql-codegen && bin/gql-schema-config 'https://swapi-graphql.netlify.app/graphql' example/ && oxfmt",
    "example": "bun run codegen && vite",
    "prepack": "bun typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.3.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.0",
    "@playwright/experimental-ct-react": "^1.62.0",
    "@playwright/test": "^1.62.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "gql.tada": "^1.11.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "peerDependencies": {
    "react": ">=19.2.0"
  }
}
