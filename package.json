{
  "name": "@bloodyowl/graphql-client",
  "version": "0.9.1",
  "license": "MIT",
  "description": "A simple, typesafe GraphQL client for React",
  "author": "Matthias Le Brun <bloodyowl@icloud.com>",
  "homepage": "https://bloodyowl.github.io/graphql-client",
  "repository": {
    "type": "git",
    "url": "https://github.com/bloodyowl/graphql-client.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "keywords": [
    "cache",
    "client",
    "gql",
    "graphql",
    "react"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "bin": {
    "generate-schema-config": "bin/generate-schema-config"
  },
  "files": [
    "bin",
    "LICENSE",
    "dist",
    "README.md"
  ],
  "scripts": {
    "lint": "oxlint",
    "example": "vite example --config vite.config.mjs",
    "format": "prettier '**/*' --ignore-unknown --write",
    "test:unit": "bun test tests/unit/",
    "test:react": "playwright test -c playwright.config.ts",
    "test": "bun run test:unit && bun run test:react",
    "typecheck": "tsc --noEmit",
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "prepack": "bun typecheck && bun run test && bun run build",
    "codegen": "graphql-codegen && bin/generate-schema-config 'https://swapi-graphql.netlify.app/graphql' example/schema.json"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.3.2",
    "@graphql-typed-document-node/core": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=19.2.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@playwright/experimental-ct-react": "^1.62.0",
    "@playwright/test": "^1.62.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "gql.tada": "^1.11.2",
    "graphql": "^16.14.2",
    "knip": "^6.18.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
